FLASK_ENV=development
SECRET_KEY=genx-super-secret-key-change-in-production-2024
DATABASE_URL=sqlite:///genx.db

# Brand Name — change here to update everywhere on the site
BRAND_NAME=GenX

# Razorpay — TEST MODE keys (get from razorpay.com/dashboard)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Shipping Partners — Sandbox/Test mode
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

DELHIVERY_TOKEN=your_delhivery_token_here

DTDC_TOKEN=your_dtdc_token_here
DTDC_API_KEY=your_dtdc_api_key_here

# Admin credentials — CHANGE BEFORE GOING LIVE
ADMIN_EMAIL=admin@genx.com
ADMIN_PASSWORD=admin123

# Default delivery partner (shiprocket / delhivery / dtdc)
DEFAULT_DELIVERY_PARTNER=shiprocket

# SMS Notifications
FAST2SMS_API_KEY=your_fast2sms_api_key_here
